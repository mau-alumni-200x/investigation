				}
			}

			/* 動きを減らす設定のユーザーにはパララックスを無効化（JS側でも判定） */
			@media (prefers-reduced-motion: reduce) {
				[data-parallax] {
					transform: none !important;
				}
			}
		</style>

		<script is:inline>
			(function () {
				var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (reduce) return;
				var els = document.querySelectorAll("[data-parallax]");
				// 各要素が「画面に入るスクロール位置」を起点に動かす（上部要素は0＝従来通り）
				var starts = [];
				function initStarts() {
					var vh = window.innerHeight;
					var y0 = window.scrollY || window.pageYOffset;
					for (var i = 0; i < els.length; i++) {
						var r = els[i].getBoundingClientRect();
						var top = r.top + y0 - (parseFloat((els[i].style.transform.match(/,\s*(-?[\d.]+)px/) || [0, 0])[1]) || 0);
						starts[i] = Math.max(0, top - vh);
					}
				}
				var ticking = false;
				function update() {
					var y = window.scrollY || window.pageYOffset;
					for (var i = 0; i < els.length; i++) {
						var s = parseFloat(els[i].getAttribute("data-parallax"));
						var d = Math.max(0, y - starts[i]);
						els[i].style.transform = "translate3d(0," + d * s + "px,0)";
					}
					ticking = false;
				}
				initStarts();
				window.addEventListener("resize", function () {
					initStarts();
					update();
				});
				window.addEventListener(
					"scroll",
					function () {
						if (!ticking) {
							requestAnimationFrame(update);
							ticking = true;
						}
					},
					{ passive: true }
				);
				update();
			})();
		</script>
	</body>
</html>
