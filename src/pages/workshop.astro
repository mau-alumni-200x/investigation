---
import { asset } from "../utils/paths.js";

// ワークショップ申込フォームURL（チラシのQR記載のもの・要確認）
const formUrl = "https://forms.gle/ZAc56xXq2kcpcsUc8";
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>子連れで！ムサビ同窓会を楽しもう | お子さま向けワークショップ 11/28</title>
		<meta
			name="description"
			content="11/28 ムサビ同窓会の隣接会場でお子さま向けワークショップを開催。ムサビ卒の現役保育士＆アトリエリスタがお預かりします。"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="hero">
			<div class="hero-lockup" data-parallax="-0.06">
				<h1 class="hero-lockupTtl">
					<img
						src={asset("assets/imgs/workshop/ttl.svg")}
						alt="ムサビ卒の現役保育士＆アトリエリスタによるワークショップ　同窓会参加者限定　子連れで！ムサビ同窓会を楽しもう　11月28日"
						width="381.39"
						height="399.3"
					/>
				</h1>
				<p class="hero-intro">
					隣接会場でお子さま向けワークショップを開催！<br />
					経験豊富なスタッフがお預かりしますので、<br />
					安心して同窓会をお楽しみください。
				</p>
			</div>

			<div class="hero-photo" data-parallax="0.06">
				<img class="hero-fade" src={asset("assets/imgs/workshop/hero-bg-grad.svg")} alt="" />
				<img class="hero-deco hero-deco--sparkWhite" src={asset("assets/imgs/workshop/hero-3.svg")} alt="" data-parallax="-0.12" />
				<img class="hero-photoImg" src={asset("assets/imgs/workshop/hero-bg@2x.png")} alt="パラバルーンで遊ぶ子どもたち" width="1195" height="1109" />
			</div>
		</header>

		<main>
			<div class="cards">
				<section class="card card--schedule" aria-labelledby="schedule-ttl">
					<img class="schedule-spark" src={asset("assets/imgs/workshop/hero-4.svg")} alt="" />
					<h2 class="card-ttl card-ttl--red" id="schedule-ttl">当日の流れ ( 予定 )</h2>
					<dl class="schedule">
						<dt>13:30</dt><dd>受付開始</dd>
						<dt>14:00</dt><dd>イントロ・ウォームアップ</dd>
						<dt>14:40</dt><dd>パラバルーンあそび</dd>
						<dt>15:00</dt><dd>休憩（10分）</dd>
						<dt>15:15</dt><dd>パラバルーンあそび 音楽に合わせて</dd>
						<dt>15:25</dt><dd>休憩（5分）</dd>
						<dt>15:30</dt><dd>パラバルーンあそび お披露目</dd>
						<dt>16:00</dt><dd>お片付け</dd>
					</dl>
					<p class="schedule-bubble">
						<span style={`background-image: url(${asset("assets/imgs/workshop/sec1-2.svg")});`}>お土産パラシュートがあるよ</span>
					</p>
					<img class="schedule-parachute" src={asset("assets/imgs/workshop/sec1-1.svg")} alt="" width="90" height="102" />
				</section>

				<section class="card" aria-labelledby="guide-ttl">
					<h2 class="card-ttl card-ttl--green" id="guide-ttl">ご利用案内</h2>
					<dl class="guide">
						<dt>会 場</dt>
						<dd>
							<span class="u-em">武蔵野美術大学 課外センター</span>
							<small class="u-right">（鷹の台ホール隣）</small>
						</dd>
						<dt>参加費</dt>
						<dd>
							1人<strong> 1,500<span class="u-unit">円</span></strong>
						</dd>
						<dt>対象年齢</dt>
						<dd class="guide-age">
							<strong>2<span class="u-unit">歳以上</span></strong>
						</dd>
						<dt>持ち物</dt>
						<dd class="guide-items">
							<span class="guide-itemsText">
								<span class="u-em">水筒</span><br />
								<span class="u-em">おやつ</span><small>（休憩で食べられるもの）</small><br />
								<span class="u-em">ハンカチ</span><br />
								<span class="u-em">ティッシュ</span><br />
								<span class="u-em">着替え・おむつ</span><small>（必要に応じて）</small><br />
								<span class="u-em">ゴミ袋</span>
							</span>
							<span class="guide-bubble" role="note">
								<img class="guide-bubbleImg" src={asset("assets/imgs/workshop/sec1-3.svg")} alt="" />
								<span class="guide-bubbleText">持ち物には<br />すべて記名を<br />お願いします</span>
							</span>
						</dd>
					</dl>
				</section>
			</div>

			<section class="hosts" aria-labelledby="hosts-ttl">
				<div class="hosts-inner">
					<h2 class="hosts-ttl" id="hosts-ttl" style={`background-image: url(${asset("assets/imgs/workshop/sec2-ttl.svg")});`}>
						<span class="hosts-ttl-text">ワークショップ<br />主催者</span>
					</h2>
					<div class="hosts-grid">
						<article class="host">
							<img class="host-img" src={asset("assets/imgs/workshop/sec2-1@2x.png")} alt="" width="448" height="329" />
							<div class="host-body">
								<p class="host-grad">2006年視デ卒</p>
								<h3 class="host-name">半澤菜穂子（なお先生）</h3>
								<p class="host-desc">
									こども園や保育園でアトリエリスタとして働きながら、子供向けのワークショップやイベントを企画・主催しています。学生時代のあだ名はだいちゃん。
								</p>
							</div>
						</article>
						<article class="host">
							<img class="host-img" src={asset("assets/imgs/workshop/sec2-2@2x.png")} alt="" width="381" height="329" />
							<div class="host-body">
								<p class="host-grad">2008年視デ卒</p>
								<h3 class="host-name">山崎佳奈（もりかな先生）</h3>
								<p class="host-desc">
									保育士として働きながら、なお先生と一緒に子供向けのイベントを開催しています。子どもが安心して過ごせる環境づくりを大切にしています。
								</p>
							</div>
						</article>
					</div>
					<p class="hosts-bubble" style={`--bubble-circle: url(${asset("assets/imgs/workshop/sec2-3.svg")});`}>
						<span>他にも10名近くの保育士や図工専科教員が<br />ボランティアで参加予定です。</span>
					</p>
				</div>
			</section>

			<section class="notes" aria-labelledby="notes-ttl">
				<div class="notes-inner">
					<h2 class="notes-ttl" id="notes-ttl">ご注意事項</h2>

					<h3 class="notes-label">当日の流れ：</h3>
					<ul>
						<li>スケジュールは変更になる場合があります。</li>
						<li>保護者から離れられないなど、お子様だけでの参加が難しい場合は、参加をお断りすることがあります。そのことによる責任は負いかねますのでご了承ください。</li>
						<li>未就学児の保護者の方は、30〜60分ごとにお子様の様子を見に来てください。</li>
						<li>ゴミの持ち帰りにご協力ください。</li>
						<li>同窓会終了後はすみやかにお迎えに来ていただくようお願いします。</li>
					</ul>

					<h3 class="notes-label">費用：</h3>
					<ul>
						<li>参加費にはレクリエーション保険、資材、ボランティアスタッフの交通費などの諸経費が含まれます。</li>
						<li>保護者の方も一緒に遊ぶ場合は、お子様とは別に参加費が必要です。（見守りだけの場合は無料です）</li>
					</ul>

					<h3 class="notes-label">対象年齢：</h3>
					<ul>
						<li>年齢に関わらず、保護者と離れてワークショップに参加できるお子様が対象となります。</li>
						<li>2歳未満でも参加できそうな場合は申し込み時にその旨をご記載ください。</li>
						<li>ムサビ同窓会に参加する方のお子様に限ります。</li>
					</ul>

				</div>
			</section>
		</main>

		<div class="cta">
			<a class="cta-btn" href={formUrl} target="_blank" rel="noopener noreferrer">お申込みはこちら</a>
		</div>

		<style>
			/* チラシPDFからピクセル実測した色 */
			:root {
				--c-text: #402010;
				--c-red: #e73945;
				--c-green: #329039;
				--c-yellow: #f4c61b;
				--c-pink: #ec7694;
				--c-brown: #804f21;
				--c-cream: #fffaee;
				--c-card: #ffffff;
				--c-hosts-bg: #fcf2c2;
				--shadow-card: 0.3rem 0.3rem 0.5rem rgba(35, 24, 21, 0.35);
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				font-size: calc(16px * 100vw / 390);
			}

			@media (min-width: 768px) {
				html {
					font-size: 16px;
				}
			}

			body {
				font-family: "Zen Kaku Gothic New", sans-serif;
				font-weight: 500;
				color: var(--c-text);
				background: var(--c-cream);
				line-height: 1.8;
			}

			img {
				max-width: 100%;
				height: auto;
			}

			/* ---------- Hero ---------- */

			.hero {
				position: relative;
				overflow: hidden;
				background: linear-gradient(175deg, #dcae76 0%, #e8cf9c 34%, #f7ecd2 60%, #fdf8e9 100%);
			}

			/* タイトル一式（デザイン合成済みSVG）＋リード文のみHTMLで重ねる */
			.hero-lockup {
				position: relative;
				z-index: 2;
				width: min(100%, 375px);
				margin: 0 auto;
				padding-top: 0.5rem;
				container-type: inline-size;
			}

			.hero-lockupTtl img {
				display: block;
				width: 100%;
				height: auto;
			}

			.hero-intro {
				position: absolute;
				left: 0;
				right: 0;
				top: 76%;
				/* タイトル（コンテナ）幅基準・最小12px。cqw非対応ブラウザはremにフォールバック */
				font-size: 0.8rem;
				font-size: max(12px, 3.28cqw);
				font-weight: 700;
				line-height: 1.4;
				text-align: center;
			}

			.hero-deco {
				position: absolute;
				z-index: 3;
			}

			.hero-deco--sparkWhite {
				top: 72%;
				left: 3%;
				width: 2.6rem;
			}

			/* 写真は雲の背後まで上げ、雲が写真に重なる（デザイン実測） */
			.hero-photo {
				position: relative;
				z-index: 1;
				margin-top: -12rem;
				height: 92vw;
				overflow: hidden;
			}

			/* 写真上端の白フェード（モバイルでは雲の重なりで代替するため非表示） */
			.hero-fade {
				display: none;
			}

			/* 写真下端は次セクションの背景色へフェードアウト */
			.hero-photo::after {
				content: "";
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				height: 5rem;
				background: linear-gradient(to bottom, rgba(255, 250, 238, 0), var(--c-cream));
			}

			/* 約1.5倍ズームで壁をカットし、写真の下端（子どもたち）を見せる */
			.hero-photoImg {
				display: block;
				width: 145%;
				max-width: none;
				height: auto;
				margin-left: -22.5%;
				margin-top: -37vw;
			}

			/* ---------- Cards ---------- */

			.cards {
				max-width: 30rem;
				margin: 0 auto;
				padding: 0.25rem 1rem 0;
				display: grid;
				gap: 1.5rem;
			}

			.card {
				position: relative;
				background: var(--c-card);
				border-radius: 0.9rem;
				box-shadow: var(--shadow-card);
			}

			.card-ttl {
				padding: 0.25rem 1rem;
				border-radius: 0.9rem 0.9rem 0 0;
				color: #fff;
				font-size: 1rem;
				font-weight: 900;
				text-align: center;
				letter-spacing: 0.05em;
				line-height: 1.6;
			}

			.card-ttl--red {
				background: var(--c-red);
			}

			.card-ttl--green {
				background: var(--c-green);
			}

			.schedule {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.1rem 0.7rem;
				padding: 0.75rem 1rem 0.1rem;
				line-height: 1.6;
			}

			.schedule dt {
				color: var(--c-red);
				font-weight: 900;
				font-size: 0.9rem;
			}

			.schedule dd {
				font-weight: 700;
				font-size: 0.85rem;
				align-self: center;
			}

			.schedule-bubble {
				display: flex;
				justify-content: flex-end;
				padding: 0.25rem 4.2rem 0.9rem 1rem;
			}

			.schedule-bubble span {
				position: relative;
				padding: 0.25rem 1.3rem;
				background: no-repeat center / 100% 100%;
				font-size: 0.82rem;
				font-weight: 700;
			}

			/* パラシュートに向く吹き出しのしっぽ（SVGはしっぽ無しピルのためCSSで付与） */
			.schedule-bubble span::after {
				content: "";
				position: absolute;
				right: -0.55rem;
				top: 50%;
				border: 0.42rem solid transparent;
				border-left-color: var(--c-yellow);
				transform: translateY(-40%) rotate(-12deg);
			}

			/* カード右上・写真に重なる黄色いキラキラ */
			.schedule-spark {
				position: absolute;
				top: -2.2rem;
				right: 2%;
				width: 3.6rem;
				z-index: 2;
			}

			/* カード右下からはみ出すパラシュート */
			.schedule-parachute {
				position: absolute;
				right: -0.5rem;
				bottom: -0.5rem;
				width: 4rem;
			}

			/* 文字階層：特大数字（strong）→ 大きめ太字（.u-em）→ 平文（dd）→ 注釈（small） */
			.guide {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.6rem 0.6rem;
				padding: 1rem 0.75rem 1.1rem;
				align-items: start;
				line-height: 1.6;
			}

			.guide dt {
				padding: 0.1rem 0.45rem;
				background: var(--c-green);
				border-radius: 0.35rem;
				color: #fff;
				font-size: max(12px, 0.78rem);
				font-weight: 700;
				text-align: center;
				white-space: nowrap;
				margin-top: 0.2rem;
			}

			.guide dd {
				font-size: 0.85rem;
				font-weight: 700;
			}

			.guide .u-em {
				font-size: 0.88rem;
				font-weight: 900;
			}

			.guide small {
				display: inline-block;
				font-size: max(12px, 0.78rem);
				font-weight: 500;
			}

			.u-right {
				display: block;
				text-align: right;
			}

			.guide strong {
				font-size: 1.35rem;
				font-weight: 900;
				white-space: nowrap;
			}

			/* 単位（円・歳〜）は数字よりひとまわり小さく */
			.guide strong .u-unit {
				font-size: 0.95rem;
			}

			.u-red {
				color: var(--c-red);
				font-style: normal;
				font-size: max(12px, 0.78rem);
				white-space: nowrap;
			}

			/* 2歳〜 と注記を横並びに */
			.guide-age {
				display: flex;
				align-items: center;
				gap: 0.7rem;
			}

			.guide-age small {
				line-height: 1.6;
			}

			/* 持ち物リスト＋右に重なる記名吹き出し */
			.guide-items {
				position: relative;
				display: block;
				padding-right: 0.5rem;
			}

			.guide-itemsText {
				display: block;
			}

			/* 吹き出し：持ち物リストの右上（本人がDevToolsで調整した実測値） */
			.guide-bubble {
				position: absolute;
				right: -1rem;
				top: -71px;
				width: 9rem;
				aspect-ratio: 152 / 106;
			}

			.guide-bubbleImg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
			}

			.guide-bubbleText {
				position: absolute;
				inset: 0;
				display: grid;
				place-content: center;
				padding-left: 0.4rem;
				font-size: max(12px, 0.78rem);
				font-weight: 700;
				line-height: 1.55;
				text-align: center;
				white-space: nowrap;
				margin-top: -0.2rem;
			}

			/* ---------- Hosts ---------- */

			.hosts {
				padding: 1.5rem 1rem 1.75rem;
				background: var(--c-hosts-bg);
			}

			.hosts-inner {
				max-width: 30rem;
				margin: 0 auto;
			}

			/* 支給のリボンSVGを背景に */
			.hosts-ttl {
				width: 8.5rem;
				padding: 0.8rem 0 1.1rem;
				background: no-repeat center / 100% 100%;
				color: #fff;
				font-size: 0.9rem;
				font-weight: 700;
				line-height: 1.5;
				text-align: center;
			}

			.hosts-ttl-text {
				display: block;
				transform: rotate(-8deg);
			}

			.hosts-grid {
				display: grid;
				gap: 1.5rem;
				margin-top: 0.25rem;
			}

			.host-img {
				display: block;
				width: 53%;
				margin: 0 auto;
			}

			.host-grad {
				margin-top: 0.4rem;
				font-size: 0.82rem;
			}

			.host-name {
				font-size: 1.1rem;
				font-weight: 900;
				border-bottom: 1.5px solid var(--c-text);
				padding-bottom: 0.1rem;
			}

			.host-desc {
				margin-top: 0.4rem;
				font-size: 0.85rem;
				line-height: 1.7;
			}

			.hosts-bubble {
				width: fit-content;
				margin: 1.5rem auto 0;
				padding: 0.9rem 1.9rem;
				background: #fff;
				border-radius: 2.2rem;
				font-size: 0.9rem;
				font-weight: 700;
				text-align: center;
			}

			/* ---------- Notes ---------- */

			.notes {
				/* 下余白は固定CTAに隠れないぶんを含む（bodyへの指定はAstroのスコープ都合で効かない） */
				padding: 1.75rem 1rem 9rem;
			}

			.notes-inner {
				max-width: 30rem;
				margin: 0 auto;
			}

			.notes-ttl {
				font-size: 1rem;
				font-weight: 900;
			}

			.notes-label {
				margin-top: 1rem;
				font-size: 0.85rem;
				font-weight: 900;
			}

			.notes ul {
				list-style: none;
			}

			.notes li {
				position: relative;
				padding-left: 1.1em;
				font-size: 0.8rem;
				line-height: 1.9;
			}

			.notes li::before {
				content: "・";
				position: absolute;
				left: 0;
			}

			/* ---------- CTA（固定） ---------- */

			.cta {
				position: fixed;
				z-index: 10;
				left: 0;
				right: 0;
				bottom: 0;
				padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
				background: rgba(255, 250, 238, 0.92);
				box-shadow: 0 -0.15rem 0.5rem rgba(122, 82, 48, 0.15);
			}

			.cta-btn {
				display: block;
				padding: 0.8rem 1rem;
				background: var(--c-pink);
				border-radius: 2.5rem;
				color: #fff;
				font-size: 1.1rem;
				font-weight: 900;
				letter-spacing: 0.08em;
				text-align: center;
				text-decoration: none;
			}

			.cta-btn::after {
				content: " »";
			}

			/* ---------- PC ---------- */

			@media (min-width: 768px) {
				.notes {
					padding-bottom: 2rem;
				}

				/* PCレイアウトはモバイル確定後に改めて作る（暫定：タイトルはデザイン原寸のままセンター） */

				.cards {
					max-width: 64rem;
					grid-template-columns: 1fr 1fr;
					align-items: start;
					padding-top: 2.5rem;
				}

				.hosts-inner {
					max-width: 64rem;
				}

				.hosts-grid {
					grid-template-columns: 1fr 1fr;
					gap: 2.5rem;
					margin-top: 1rem;
				}

				/* PC（A4版）はイラスト左・テキスト右 */
				.host {
					display: grid;
					grid-template-columns: 10rem 1fr;
					gap: 1rem;
					align-items: start;
				}

				.host-img {
					width: 100%;
					margin: 0;
				}

				.host-grad {
					margin-top: 0;
				}

				/* PC（A4版）は白丸の吹き出し */
				.hosts-bubble {
					background: var(--bubble-circle) no-repeat center / 100% 100%;
					width: 11.5rem;
					height: 11.5rem;
					display: grid;
					place-content: center;
					padding: 1.5rem;
					border-radius: 0;
					margin-top: -3rem;
					margin-right: 2rem;
					margin-left: auto;
				}

				.notes-inner {
					max-width: 64rem;
				}

				.cta {
					left: auto;
					right: 1.5rem;
					bottom: 1.5rem;
					padding: 0;
					background: none;
					box-shadow: none;
				}

				.cta-btn {
					padding: 1rem 2.2rem;
					box-shadow: 0 0.25rem 0.75rem rgba(122, 82, 48, 0.3);
				}
			}

			/* 動きを減らす設定のユーザーにはパララックスを無効化（JS側でも判定） */
			@media (prefers-reduced-motion: reduce) {
				[data-parallax] {
					transform: none !important;
				}
			}
		</style>

		<script is:inline>
			(function () {
				var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (reduce) return;
				var els = document.querySelectorAll("[data-parallax]");
				var ticking = false;
				function update() {
					var y = window.scrollY || window.pageYOffset;
					for (var i = 0; i < els.length; i++) {
						var s = parseFloat(els[i].getAttribute("data-parallax"));
						els[i].style.transform = "translate3d(0," + y * s + "px,0)";
					}
					ticking = false;
				}
				window.addEventListener(
					"scroll",
					function () {
						if (!ticking) {
							requestAnimationFrame(update);
							ticking = true;
						}
					},
					{ passive: true }
				);
				update();
			})();
		</script>
	</body>
</html>
