---
import { asset } from "../utils/paths.js";

// ワークショップ申込フォームURL（チラシのQR記載のもの・要確認）
const formUrl = "https://forms.gle/ZAc56xXq2kcpcsUc8";
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>子連れで！ムサビ同窓会を楽しもう | お子さま向けワークショップ 11/28</title>
		<meta
			name="description"
			content="11/28 ムサビ同窓会の隣接会場でお子さま向けワークショップを開催。ムサビ卒の現役保育士＆アトリエリスタがお預かりします。"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="hero">
			<div class="hero-lockup" data-parallax="-0.06">
				<h1 class="hero-lockupTtl">
					<img
						src={asset("assets/imgs/workshop/ttl.svg")}
						alt="ムサビ卒の現役保育士＆アトリエリスタによるワークショップ　同窓会参加者限定　子連れで！ムサビ同窓会を楽しもう　11月28日"
						width="381.39"
						height="399.3"
					/>
				</h1>
				<p class="hero-intro">
					隣接会場でお子さま向けワークショップを開催！<br />
					経験豊富なスタッフがお預かりしますので、<br />
					安心して同窓会をお楽しみください。
				</p>
			</div>

			<div class="hero-photo" data-parallax="0.06">
				<img class="hero-fade" src={asset("assets/imgs/workshop/hero-bg-grad.svg")} alt="" />
				<img class="hero-deco hero-deco--sparkWhite" src={asset("assets/imgs/workshop/hero-3.svg")} alt="" data-parallax="-0.12" />
				<img class="hero-photoImg" src={asset("assets/imgs/workshop/hero-bg@2x.png")} alt="パラバルーンで遊ぶ子どもたち" width="1195" height="1109" />
			</div>
		</header>

		<main>
			<div class="cards">
				<section class="card card--schedule" aria-labelledby="schedule-ttl">
					<img class="schedule-spark" src={asset("assets/imgs/workshop/hero-4.svg")} alt="" />
					<h2 class="card-ttl card-ttl--red" id="schedule-ttl">当日の流れ ( 予定 )</h2>
					<dl class="schedule">
						<dt>13:30 〜</dt><dd>受付開始</dd>
						<dt>14:00 〜</dt><dd>ご挨拶　イントロ　ウォーミングアップ</dd>
						<dt>14:40 〜</dt><dd>パラバルーンあそび</dd>
						<dt>15:00 〜</dt><dd>休憩 10分</dd>
						<dt>15:15 〜</dt><dd>パラバルーンあそび　音楽に合わせて</dd>
						<dt>15:25 〜</dt><dd>休憩 5分</dd>
						<dt>15:30 〜</dt><dd>パラバルーンあそびお披露目</dd>
						<dt>16:00 〜</dt><dd>お片づけ、お迎えまであそび</dd>
					</dl>
					<p class="schedule-bubble">
						<span style={`background-image: url(${asset("assets/imgs/workshop/sec1-2.svg")});`}>お土産パラシュートがあるよ</span>
					</p>
					<img class="schedule-parachute" src={asset("assets/imgs/workshop/sec1-1.svg")} alt="" width="90" height="102" />
				</section>

				<section class="card" aria-labelledby="guide-ttl">
					<h2 class="card-ttl card-ttl--green" id="guide-ttl">ご利用案内</h2>
					<dl class="guide">
						<dt>会 場</dt>
						<dd>
							武蔵野美術大学　課外センター
							<small class="u-right">（鷹の台ホール隣）</small>
						</dd>
						<dt>参加費</dt>
						<dd>
							お子様一人<strong> 1,500円 </strong><em class="u-red">※現金のみ</em><br />
							<small>※保護者の参加もOK！参加無料。</small>
						</dd>
						<dt>対象年齢</dt>
						<dd class="guide-age">
							<strong>2歳〜</strong>
							<small>※2歳未満でも、保護者と離れて過ごせるお子さんはご相談ください。</small>
						</dd>
						<dt>持ち物</dt>
						<dd class="guide-items">
							<span class="guide-itemsText">
								水筒、おやつ<small>（休憩で食べられるもの）</small>、ハンカチ、ティッシュ、着替え・オムツ<small>（必要に応じて）</small>、ゴミ袋<small>（ゴミ持ち帰り用）</small>
							</span>
							<span class="guide-bubble" role="note">
								<svg viewBox="0 0 100 70" aria-hidden="true" preserveAspectRatio="none">
									<defs>
										<filter id="bubble-shadow" x="-20%" y="-20%" width="150%" height="150%">
											<feDropShadow dx="2" dy="2" stdDeviation="2" flood-color="#231815" flood-opacity="0.35" />
										</filter>
									</defs>
									<path
										fill="#f4c61b"
										filter="url(#bubble-shadow)"
										d="M72.78,6.1H28.68c-8.56,0-15.49,6.94-15.49,15.49v8.33l-7.23.43,7.23,5.34v6.83c0,8.56,6.94,15.49,15.49,15.49h44.1c8.56,0,15.49-6.94,15.49-15.49v-20.92c0-8.56-6.94-15.49-15.49-15.49Z"
									/>
								</svg>
								<span class="guide-bubbleText">持ち物には<br />すべて記名を<br />お願いします</span>
							</span>
						</dd>
					</dl>
				</section>
			</div>

			<p class="applyInline">
				<a class="applyInline-btn" href={formUrl} target="_blank" rel="noopener noreferrer">お申込みはこちら</a>
			</p>

			<section class="hosts" aria-labelledby="hosts-ttl">
				<div class="hosts-inner">
					<h2 class="hosts-ttl" id="hosts-ttl" style={`background-image: url(${asset("assets/imgs/workshop/sec2-ttl.svg")});`}>
						<span class="hosts-ttl-text">ワークショップ<br />主催者</span>
					</h2>
					<div class="hosts-grid">
						<article class="host">
							<img class="host-img" src={asset("assets/imgs/workshop/sec2-1@2x.png")} alt="" width="448" height="329" />
							<div class="host-body">
								<p class="host-grad">2006年視デ卒</p>
								<h3 class="host-name">半澤菜穂子（だいちゃん）</h3>
								<p class="host-desc">
									現役こども園、保育園にてアトリエリスタとして働いているお先生。一日に最大40人の幼児と一斉にワークショップを行っている。ボーイスカウト、こどもワークショップの経験があり、乳児から中高生まで活動を行ってきた。
								</p>
							</div>
						</article>
						<article class="host">
							<img class="host-img" src={asset("assets/imgs/workshop/sec2-2@2x.png")} alt="" width="381" height="329" />
							<div class="host-body">
								<p class="host-grad">2008年視デ卒</p>
								<h3 class="host-name">山崎佳奈（もりかな）</h3>
								<p class="host-desc">
									視デ卒業後保育士資格を取得。現役保育士。泣く子にも寄り添い動じない安心を作る先生。
								</p>
							</div>
						</article>
					</div>
					<p class="hosts-bubble" style={`--bubble-circle: url(${asset("assets/imgs/workshop/sec2-3.svg")});`}>
						<span>他、保育士仲間、図工専科教員も<br />サポートします！</span>
					</p>
				</div>
			</section>

			<section class="notes" aria-label="注意事項">
				<ul>
					<li>参加費には、レクリエーション保険、お土産パラシュート、備品、スタッフへの交通費等含ませていただいております。</li>
					<li>未就学児の保護者の方は、30〜60分ごとにお子さまの様子を見に来ていただけると幸いです。</li>
					<li>2歳未満のお子さまや、保護者と離れることが難しい場合は、同窓会への参加が難しくなることがあります。</li>
					<li>現役保育士・アトリエリスタが責任を持ってお子さまをお預かりします。安心してお任せください。</li>
					<li>保護者の不安はお子さまに伝わります。当日は安心して送り出すお気持ちでお越しください。</li>
					<li>お子さまが泣いたり離れられなかったことによる苦情・ご意見はご遠慮ください。</li>
				</ul>
			</section>
		</main>

		<div class="cta">
			<a class="cta-btn" href={formUrl} target="_blank" rel="noopener noreferrer">お申込みはこちら</a>
		</div>

		<style>
			/* チラシPDFからピクセル実測した色 */
			:root {
				--c-text: #402010;
				--c-red: #e73945;
				--c-green: #329039;
				--c-yellow: #f4c61b;
				--c-pink: #ec7694;
				--c-brown: #804f21;
				--c-cream: #fffaee;
				--c-card: #ffffff;
				--c-hosts-bg: #fcf2c2;
				--shadow-card: 0.3rem 0.3rem 0.5rem rgba(35, 24, 21, 0.35);
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				font-size: calc(16px * 100vw / 390);
			}

			@media (min-width: 768px) {
				html {
					font-size: 16px;
				}
			}

			body {
				font-family: "Zen Kaku Gothic New", sans-serif;
				font-weight: 500;
				color: var(--c-text);
				background: var(--c-cream);
				line-height: 1.8;
				/* モバイルの固定CTAぶんの逃げ */
				padding-bottom: 9rem;
			}

			img {
				max-width: 100%;
				height: auto;
			}

			/* ---------- Hero ---------- */

			.hero {
				position: relative;
				overflow: hidden;
				background: linear-gradient(175deg, #dcae76 0%, #e8cf9c 34%, #f7ecd2 60%, #fdf8e9 100%);
			}

			/* タイトル一式（デザイン合成済みSVG）＋リード文のみHTMLで重ねる */
			.hero-lockup {
				position: relative;
				z-index: 2;
				max-width: 30rem;
				margin: 0 auto;
			}

			.hero-lockupTtl img {
				display: block;
				width: 100%;
				height: auto;
			}

			.hero-intro {
				position: absolute;
				left: 0;
				right: 0;
				top: 76%;
				font-size: 0.8rem;
				font-weight: 700;
				line-height: 1.4;
				text-align: center;
			}

			.hero-deco {
				position: absolute;
				z-index: 3;
			}

			.hero-deco--sparkWhite {
				top: 72%;
				left: 3%;
				width: 2.6rem;
			}

			/* 写真は雲の背後まで上げ、雲が写真に重なる（デザイン実測） */
			.hero-photo {
				position: relative;
				z-index: 1;
				margin-top: -9.5rem;
				height: 92vw;
				overflow: hidden;
			}

			/* 写真上端の白フェード（モバイルでは雲の重なりで代替するため非表示） */
			.hero-fade {
				display: none;
			}

			/* 約1.5倍ズームで壁をカットし、写真の下端（子どもたち）を見せる */
			.hero-photoImg {
				display: block;
				width: 145%;
				max-width: none;
				height: auto;
				margin-left: -22.5%;
				margin-top: -37vw;
			}

			/* ---------- Cards ---------- */

			.cards {
				max-width: 30rem;
				margin: 0 auto;
				padding: 0.25rem 1rem 0;
				display: grid;
				gap: 1.5rem;
			}

			.card {
				position: relative;
				background: var(--c-card);
				border-radius: 0.9rem;
				box-shadow: var(--shadow-card);
			}

			.card-ttl {
				padding: 0.25rem 1rem;
				border-radius: 0.9rem 0.9rem 0 0;
				color: #fff;
				font-size: 1rem;
				font-weight: 900;
				text-align: center;
				letter-spacing: 0.05em;
				line-height: 1.6;
			}

			.card-ttl--red {
				background: var(--c-red);
			}

			.card-ttl--green {
				background: var(--c-green);
			}

			.schedule {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.1rem 0.7rem;
				padding: 0.75rem 1rem 0.1rem;
				line-height: 1.6;
			}

			.schedule dt {
				color: var(--c-red);
				font-weight: 900;
				font-size: 0.9rem;
			}

			.schedule dd {
				font-weight: 700;
				font-size: 0.85rem;
				align-self: center;
			}

			.schedule-bubble {
				display: flex;
				justify-content: center;
				padding: 0.25rem 4.5rem 0.9rem 1rem;
			}

			.schedule-bubble span {
				position: relative;
				padding: 0.25rem 1.3rem;
				background: no-repeat center / 100% 100%;
				font-size: 0.82rem;
				font-weight: 700;
			}

			/* カード右上・写真に重なる黄色いキラキラ */
			.schedule-spark {
				position: absolute;
				top: -2.2rem;
				right: 2%;
				width: 3.6rem;
				z-index: 2;
			}

			/* カード右下からはみ出すパラシュート */
			.schedule-parachute {
				position: absolute;
				right: -0.5rem;
				bottom: -0.5rem;
				width: 4rem;
			}

			.guide {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.6rem 0.8rem;
				padding: 1rem 1rem 1.1rem;
				align-items: start;
				line-height: 1.6;
			}

			.guide dt {
				padding: 0.15rem 0.6rem;
				background: var(--c-green);
				border-radius: 0.35rem;
				color: #fff;
				font-size: 0.8rem;
				font-weight: 700;
				text-align: center;
				white-space: nowrap;
				margin-top: 0.2rem;
			}

			.guide dd {
				font-size: 0.9rem;
				font-weight: 700;
			}

			.guide small {
				display: inline-block;
				font-size: 0.75rem;
				font-weight: 500;
			}

			.u-right {
				display: block;
				text-align: right;
			}

			.guide strong {
				font-size: 1.1rem;
				font-weight: 900;
				white-space: nowrap;
			}

			.u-red {
				color: var(--c-red);
				font-style: normal;
				font-size: 0.75rem;
				white-space: nowrap;
			}

			/* 2歳〜 と注記を横並びに */
			.guide-age {
				display: flex;
				align-items: center;
				gap: 0.7rem;
			}

			.guide-age small {
				line-height: 1.6;
			}

			/* 持ち物リスト＋右に重なる記名吹き出し */
			.guide-items {
				position: relative;
				display: block;
				padding-right: 0.5rem;
			}

			.guide-itemsText {
				display: block;
				width: 60%;
			}

			.guide-bubble {
				position: absolute;
				top: 50%;
				right: -1.5rem;
				width: 7.5rem;
				aspect-ratio: 100 / 70;
				transform: translateY(-50%);
			}

			.guide-bubble svg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
			}

			.guide-bubbleText {
				position: absolute;
				inset: 0;
				display: grid;
				place-content: center;
				padding-left: 0.6rem;
				font-size: 0.72rem;
				font-weight: 700;
				line-height: 1.7;
				text-align: center;
			}

			/* ---------- 申込ボタン（本文中） ---------- */

			.applyInline {
				max-width: 30rem;
				margin: 0 auto;
				padding: 1rem 1rem 1.25rem;
			}

			.applyInline-btn {
				display: block;
				padding: 0.7rem;
				background: var(--c-pink);
				border-radius: 1.1rem;
				box-shadow: var(--shadow-card);
				color: #fff;
				font-size: 1.25rem;
				font-weight: 900;
				letter-spacing: 0.08em;
				text-align: center;
				text-decoration: none;
			}

			.applyInline-btn::after {
				content: " ＞";
				font-size: 1.1rem;
			}

			/* ---------- Hosts ---------- */

			.hosts {
				padding: 1.5rem 1rem 1.75rem;
				background: var(--c-hosts-bg);
			}

			.hosts-inner {
				max-width: 30rem;
				margin: 0 auto;
			}

			/* 支給のリボンSVGを背景に */
			.hosts-ttl {
				width: 8.5rem;
				padding: 0.8rem 0 1.1rem;
				background: no-repeat center / 100% 100%;
				color: #fff;
				font-size: 0.9rem;
				font-weight: 700;
				line-height: 1.5;
				text-align: center;
			}

			.hosts-ttl-text {
				display: block;
				transform: rotate(-4deg);
			}

			.hosts-grid {
				display: grid;
				gap: 1.5rem;
				margin-top: 0.25rem;
			}

			.host-img {
				display: block;
				width: 53%;
				margin: 0 auto;
			}

			.host-grad {
				margin-top: 0.4rem;
				font-size: 0.82rem;
			}

			.host-name {
				font-size: 1.1rem;
				font-weight: 900;
				border-bottom: 1.5px solid var(--c-text);
				padding-bottom: 0.1rem;
			}

			.host-desc {
				margin-top: 0.4rem;
				font-size: 0.85rem;
				line-height: 1.7;
			}

			.hosts-bubble {
				width: fit-content;
				margin: 1.5rem auto 0;
				padding: 0.9rem 1.9rem;
				background: #fff;
				border-radius: 2.2rem;
				font-size: 0.9rem;
				font-weight: 700;
				text-align: center;
			}

			/* ---------- Notes ---------- */

			.notes {
				padding: 1.75rem 1rem 2rem;
			}

			.notes ul {
				max-width: 30rem;
				margin: 0 auto;
				list-style: none;
			}

			.notes li {
				position: relative;
				padding-left: 1.4em;
				font-size: 0.8rem;
				line-height: 1.9;
			}

			.notes li::before {
				content: "※";
				position: absolute;
				left: 0;
			}

			/* ---------- CTA（固定） ---------- */

			.cta {
				position: fixed;
				z-index: 10;
				left: 0;
				right: 0;
				bottom: 0;
				padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
				background: rgba(255, 250, 238, 0.92);
				box-shadow: 0 -0.15rem 0.5rem rgba(122, 82, 48, 0.15);
			}

			.cta-btn {
				display: block;
				padding: 0.8rem 1rem;
				background: var(--c-pink);
				border-radius: 2.5rem;
				color: #fff;
				font-size: 1.1rem;
				font-weight: 900;
				letter-spacing: 0.08em;
				text-align: center;
				text-decoration: none;
			}

			.cta-btn::after {
				content: " »";
			}

			/* ---------- PC ---------- */

			@media (min-width: 768px) {
				body {
					padding-bottom: 0;
				}

				/* PCレイアウトはモバイル確定後に改めて作る（暫定：センター寄せのまま） */
				.hero-lockup {
					max-width: 30rem;
				}

				.cards {
					max-width: 64rem;
					grid-template-columns: 1fr 1fr;
					align-items: start;
					padding-top: 2.5rem;
				}

				.applyInline {
					max-width: 30rem;
					padding: 2.25rem 1rem;
				}

				.hosts-inner {
					max-width: 64rem;
				}

				.hosts-grid {
					grid-template-columns: 1fr 1fr;
					gap: 2.5rem;
					margin-top: 1rem;
				}

				/* PC（A4版）はイラスト左・テキスト右 */
				.host {
					display: grid;
					grid-template-columns: 10rem 1fr;
					gap: 1rem;
					align-items: start;
				}

				.host-img {
					width: 100%;
					margin: 0;
				}

				.host-grad {
					margin-top: 0;
				}

				/* PC（A4版）は白丸の吹き出し */
				.hosts-bubble {
					background: var(--bubble-circle) no-repeat center / 100% 100%;
					width: 11.5rem;
					height: 11.5rem;
					display: grid;
					place-content: center;
					padding: 1.5rem;
					border-radius: 0;
					margin-top: -3rem;
					margin-right: 2rem;
					margin-left: auto;
				}

				.notes ul {
					max-width: 64rem;
				}

				.cta {
					left: auto;
					right: 1.5rem;
					bottom: 1.5rem;
					padding: 0;
					background: none;
					box-shadow: none;
				}

				.cta-btn {
					padding: 1rem 2.2rem;
					box-shadow: 0 0.25rem 0.75rem rgba(122, 82, 48, 0.3);
				}
			}

			/* 動きを減らす設定のユーザーにはパララックスを無効化（JS側でも判定） */
			@media (prefers-reduced-motion: reduce) {
				[data-parallax] {
					transform: none !important;
				}
			}
		</style>

		<script is:inline>
			// 本文中の申込ボタンが見えている間は固定CTAを隠す
			(function () {
				var cta = document.querySelector(".cta");
				var inlineBtn = document.querySelector(".applyInline");
				if (!("IntersectionObserver" in window) || !cta || !inlineBtn) return;
				new IntersectionObserver(function (entries) {
					cta.style.opacity = entries[0].isIntersecting ? "0" : "1";
					cta.style.pointerEvents = entries[0].isIntersecting ? "none" : "auto";
					cta.style.transition = "opacity 0.25s";
				}).observe(inlineBtn);
			})();

			(function () {
				var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (reduce) return;
				var els = document.querySelectorAll("[data-parallax]");
				var ticking = false;
				function update() {
					var y = window.scrollY || window.pageYOffset;
					for (var i = 0; i < els.length; i++) {
						var s = parseFloat(els[i].getAttribute("data-parallax"));
						els[i].style.transform = "translate3d(0," + y * s + "px,0)";
					}
					ticking = false;
				}
				window.addEventListener(
					"scroll",
					function () {
						if (!ticking) {
							requestAnimationFrame(update);
							ticking = true;
						}
					},
					{ passive: true }
				);
				update();
			})();
		</script>
	</body>
</html>
